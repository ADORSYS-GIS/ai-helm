          "sort": "desc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (model) (rate(aisix_llm_input_tokens_total{job=\"converse/aisix\", model=~\"$model\"}[$__rate_interval])) * 60",
          "instant": false,
          "legendFormat": "input · {{model}}",
