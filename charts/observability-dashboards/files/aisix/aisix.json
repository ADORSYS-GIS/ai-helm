      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "`cached` is what the PROVIDER reported as a prompt-cache hit. On DeepInfra it is 0 on every call today — which is exactly why moving to /v1/responses does not make the bill cheaper.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 49
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
