      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Total tokens (input + output) as AISIX counted them. The billed figure is EAIG's, metered from the same response — these should agree, and a persistent gap is a bug worth filing, not a rounding artefact.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 49
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (model) (rate(aisix_llm_total_tokens_total{job=\"converse/aisix\", model=~\"$model\"}[$__rate_interval])) * 60",
