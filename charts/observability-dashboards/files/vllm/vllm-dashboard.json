{
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "model_name",
        "label": "Model",
        "skipUrlSync": false,
        "query": "label_values(vllm:request_success_total, model_name)",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ],
          "selected": true
        },
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".+",
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      }
    ]
  },
  "annotations": {},
  "uid": "vllm-perf-dashboard",
  "title": "vLLM Inference - Comprehensive",
  "description": "Comprehensive vLLM inference engine performance dashboard. Reads vLLM's built-in Prometheus exporter metrics (vllm:engine) via Mimir. Covers request success/error rates, generation/prompt token throughput, end-to-end latency + TTFT + inter-token + prefill latency (p50/p90/p95/p99), request queue depth, KV-cache usage, prefix-cache hit rate, and preemption counts. The model_name template variable filters every panel. GENERATED — source: tools/dashboards/src/dashboards/vllm/vllm.py.",
  "tags": [
    "vllm",
    "llm",
    "inference",
    "gpu"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "targets": [
        {
          "expr": "vllm:request_success_total{model_name=~\"$model_name\"}",
          "refId": "A",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        }
      ],
      "title": "Successful Requests",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
