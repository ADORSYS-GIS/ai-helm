{
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "node",
        "label": "GPU node",
        "skipUrlSync": false,
        "query": "label_values(DCGM_FI_DEV_FB_USED, hostname)",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ],
          "selected": true
        },
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".+",
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      }
    ]
  },
  "annotations": {},
  "uid": "gpu-fleet-attribution",
  "title": "GPU Fleet — cards and the models on them",
  "description": "Which model is on which GPU, and what it costs in silicon. Joins DCGM per-card telemetry to the workload using the card via DCGM's own pod/namespace labels (which survive only because the ServiceMonitor sets honorLabels: true). For general per-card health — clocks, temperature, power curves — see the adopted community board 'NVIDIA DCGM Exporter (12239)'. GENERATED — source: tools/dashboards/src/dashboards/gpu/gpu_fleet.py.",
  "tags": [
    "gpu",
    "dcgm",
    "inference",
    "model-serving"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "targets": [
        {
          "expr": "DCGM_FI_DEV_FB_USED{hostname=~\"$node\"}",
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "{{hostname}} · {{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        }
      ],
      "title": "VRAM used",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 17000,
                "color": "yellow"
              },
              {
                "value": 19500,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      }
    },
