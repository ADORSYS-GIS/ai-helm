  "annotations": {},
  "uid": "envoy-ai-gateway-provider-billing",
  "title": "AI Gateway — provider billing & reconciliation",
  "description": "Provider-billed cost (invoice source of truth, polled from DeepInfra by the provider-billing-exporter) reconciled against the gateway's estimated cost (ADR-0058 Mimir metric) and the Redis limiter spend (ADR-0070). Provider metrics are cumulative gauges per UTC billing period. The reconciliation delta = provider-billed minus gateway-estimated (absolute $ and %). GENERATED — source: tools/dashboards/envoy_ai_gateway/provider_billing.py.",
  "tags": [
    "ai-gateway",
    "cost",
    "billing",
    "provider",
    "mimir"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "refresh": "1h",
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "id": 0,
      "panels": [],
      "title": "Invoice truth vs gateway estimate vs limiter",
