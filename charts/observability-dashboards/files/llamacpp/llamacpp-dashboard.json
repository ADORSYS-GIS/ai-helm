{
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "model",
        "label": "Model",
        "skipUrlSync": false,
        "query": "label_values(llamacpp:requests_processing, job)",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ],
          "selected": true
        },
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".+",
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      }
    ]
  },
  "annotations": {},
  "uid": "llamacpp-perf-dashboard",
  "title": "llama.cpp Inference",
  "description": "llama.cpp (llama-server) inference performance, read from the llamacpp:* Prometheus exporter via Mimir. Companion to the vLLM board — the two engines publish disjoint metric namespaces, so each tier of the GPU fleet has its own dashboard. NOTE: llama.cpp exports counters and gauges only, no histograms, so latency panels are AVERAGES (seconds_total / tokens_total), not percentiles. The `model` variable filters on the scrape job, because this exporter emits no model_name label. GENERATED — source: tools/dashboards/src/dashboards/llamacpp/llamacpp.py.",
  "tags": [
    "llamacpp",
    "llm",
    "inference",
    "gpu"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "targets": [
        {
          "expr": "llamacpp:predicted_tokens_seconds{job=~\"$model\"}",
          "refId": "A",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        }
      ],
      "title": "Decode (tok/s, live)",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "tokens/s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 5,
                "color": "yellow"
              },
              {
                "value": 10,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
