# justfile for Artillery load testing — Qwen2.5-3B-AWQ + vLLM ± LMCache
# Usage: just <command>
# Run from the plans/artillery directory

# Default: show available commands
default:
    @just --list

# ============================================================================
# Prerequisites
# ============================================================================

# Check if required tools are installed
check-deps:
    @echo "Checking dependencies..."
    @command -v artillery >/dev/null 2>&1 || { echo "❌ artillery not found. Run: npm install -g artillery"; exit 1; }
    @command -v kubectl >/dev/null 2>&1 || { echo "❌ kubectl not found"; exit 1; }
    @command -v jq >/dev/null 2>&1 || { echo "❌ jq not found"; exit 1; }
    @echo "✅ All dependencies available"

# ============================================================================
# Self-Hosted Model Utilities
# ============================================================================

# Resolve VLLM_LOCAL_API_KEY from the Kubernetes secret
qwen25-api-key:
    @kubectl get secret vllm-local-api-key -n custom-ai-ops -o jsonpath='{.data.api_key}' | base64 -d

# Setup port-forward to qwen25-3b-awq Service (Caddy proxy on :8090)
qwen25-port-forward:
    @echo "Starting port-forward to qwen25-3b-awq..."
    @kubectl port-forward svc/qwen25-3b-awq 8090:8090 -n custom-ai-ops &
    @sleep 2
    @echo "Port-forward active on localhost:8090"

# Kill qwen25 port-forward
qwen25-kill-port-forward:
    @pkill -f "port-forward.*qwen25" 2>/dev/null || true

# Check that qwen25 model is ready
qwen25-check:
    @echo "Checking qwen25-3b-awq pod..."
    @kubectl wait pod/qwen25-3b-awq-main-0 -n custom-ai-ops --for=condition=Ready --timeout=300s
    @echo "Model is ready"

# Scrape vLLM /metrics (for lmcache:* counters on LMCache variant)
qwen25-metrics:
    @echo "=== vLLM /metrics ==="
    @kubectl exec -n custom-ai-ops qwen25-3b-awq-main-0 -c model -- curl -s http://localhost:8080/metrics > reports/metrics-raw.txt
    @grep -E "^vllm:|^lmcache:" reports/metrics-raw.txt > reports/metrics-lmcache.txt || true
    @echo "Full metrics: reports/metrics-raw.txt"
    @echo "LMCache metrics: reports/metrics-lmcache.txt"
    @echo "LMCache hit tokens:" && grep "lmcache:num_hit_tokens" reports/metrics-lmcache.txt || echo "  (none — LMCache not enabled or no hits yet)"
    @echo "LMCache retrieve hit rate:" && grep "lmcache:retrieve_hit_rate" reports/metrics-lmcache.txt || echo "  (none)"

# ============================================================================
# Experiment B (Approach B): APC eviction test
# ============================================================================
# Approach B keeps vLLM APC ENABLED on both variants and forces GPU KV eviction
# via tight VRAM budget (--gpu-memory-utilization=0.55), high concurrency
# (--max-num-seqs=8), and cache-buster prompts. When APC evicts the shared
# prefix, the LMCache treatment retrieves it from CPU RAM (~9ms) instead of
# recomputing (seconds). This is the final, most production-realistic experiment.
#
# Override files:
#   charts/.../local-overrides-approachb.yaml         — baseline (APC on, no LMCache)
#   charts/.../local-overrides-approachb-lmcache.yaml — treatment (APC on + LMCache)
#
# Artillery configs:
#   self-hosted-model/artillery-qwen25-eviction.yml     — ~5K-token prefix, buster:prefix 1:1
#   self-hosted-model/artillery-qwen25-huge-prefix.yml  — ~9.7K-token prefix, buster:prefix 2:1

# Create reports directory
reports-dir:
    @mkdir -p reports

# Generate the eviction-busters.csv file (~20 unique ~2K-token prompts)
qwen25-gen-busters:
    @echo "=== Generating eviction-busters.csv ==="
    @cd self-hosted-model && node generate-eviction-busters.js

# Deploy Approach B baseline (APC enabled, no LMCache, tight VRAM)
qwen25-deploy-approachb-baseline:
    @echo "=== Deploying Approach B baseline (APC, no LMCache, gpu-mem=0.55) ==="
    helm upgrade --install model-serving-qwen25-3b-awq ./charts/model-serving-qwen25-3b-awq \
      -n custom-ai-ops -f charts/model-serving-qwen25-3b-awq/local-overrides-approachb.yaml
    @just qwen25-check

# Deploy Approach B treatment (APC enabled + LMCache, tight VRAM)
qwen25-deploy-approachb-lmcache:
    @echo "=== Deploying Approach B treatment (APC + LMCache, gpu-mem=0.55) ==="
    helm upgrade --install model-serving-qwen25-3b-awq ./charts/model-serving-qwen25-3b-awq \
      -n custom-ai-ops -f charts/model-serving-qwen25-3b-awq/local-overrides-approachb-lmcache.yaml
    @just qwen25-check

# Run eviction mix test (~5K-token shared prefix, buster:prefix 1:1, 120s @ 2 RPS)
# Uses artillery-qwen25-eviction.yml + self-hosted-model/eviction-busters.csv
qwen25-eviction: check-deps reports-dir qwen25-gen-busters
    @test -n "$$VLLM_LOCAL_API_KEY" || { echo "❌ VLLM_LOCAL_API_KEY not set. Run: export VLLM_LOCAL_API_KEY=$$(just qwen25-api-key)"; exit 1; }
    @echo "=== Approach B: Eviction Load Test (~5K prefix) ==="
    artillery run self-hosted-model/artillery-qwen25-eviction.yml -o reports/report-qwen25-eviction.json
    node generate-report.js reports/report-qwen25-eviction.json reports/report-qwen25-eviction.html
    @echo "Report: reports/report-qwen25-eviction.html"

# Run huge-prefix eviction test (~9.7K-token shared prefix, buster:prefix 2:1, 120s @ 2 RPS)
# Uses artillery-qwen25-huge-prefix.yml + self-hosted-model/huge-prefix.csv
# huge-prefix.csv is committed; regenerate with: cd self-hosted-model && node generate-huge-prefix.js
qwen25-huge-prefix: check-deps reports-dir qwen25-gen-busters
    @test -n "$$VLLM_LOCAL_API_KEY" || { echo "❌ VLLM_LOCAL_API_KEY not set. Run: export VLLM_LOCAL_API_KEY=$$(just qwen25-api-key)"; exit 1; }
    @echo "=== Approach B: Huge-Prefix Eviction Load Test (~9.7K prefix) ==="
    artillery run self-hosted-model/artillery-qwen25-huge-prefix.yml -o reports/report-qwen25-huge-prefix.json
    node generate-report.js reports/report-qwen25-huge-prefix.json reports/report-qwen25-huge-prefix.html
    @echo "Report: reports/report-qwen25-huge-prefix.html"

# Full Approach B A/B test: deploy baseline → huge-prefix test → deploy LMCache → huge-prefix test → compare
# Uses the huge-prefix config (v4, most dramatic results — p50 -94.9%).
# To use the smaller eviction config instead, replace qwen25-huge-prefix with qwen25-eviction below.
qwen25-approachb-full:
    @echo "=========================================="
    @echo "  Approach B: APC Eviction A/B Test"
    @echo "  Config: ~9.7K huge prefix, buster:prefix 2:1"
    @echo "=========================================="
    @echo ""
    @echo "--- Phase 1: Baseline (APC, no LMCache) ---"
    @just qwen25-deploy-approachb-baseline
    @just qwen25-port-forward
    @just qwen25-huge-prefix
    @cp reports/report-qwen25-huge-prefix.json reports/report-qwen25-huge-prefix-nolmcache.json
    @cp reports/report-qwen25-huge-prefix.html reports/report-qwen25-huge-prefix-nolmcache.html
    @just qwen25-kill-port-forward
    @echo ""
    @echo "--- Phase 2: Treatment (APC + LMCache) ---"
    @just qwen25-deploy-approachb-lmcache
    @just qwen25-port-forward
    @just qwen25-huge-prefix
    @cp reports/report-qwen25-huge-prefix.json reports/report-qwen25-huge-prefix-lmcache.json
    @cp reports/report-qwen25-huge-prefix.html reports/report-qwen25-huge-prefix-lmcache.html
    @just qwen25-metrics
    @just qwen25-kill-port-forward
    @echo ""
    @echo "--- Phase 3: Comparison ---"
    @node self-hosted-model/generate-comparison.js \
      reports/report-qwen25-huge-prefix-nolmcache.json \
      reports/report-qwen25-huge-prefix-lmcache.json \
      "Huge prefix eviction (APC enabled, ~9.7K tokens)" \
      reports/comparison-huge-prefix.md
    @echo ""
    @echo "=========================================="
    @echo "  Approach B A/B Test Complete"
    @echo "=========================================="

# ============================================================================
# Analysis & Reports
# ============================================================================

# Generate HTML report from existing JSON
report report:
    @echo "Generating HTML report for {{ report }}..."
    node generate-report.js reports/{{ report }}.json reports/{{ report }}.html
    @echo "Report: reports/{{ report }}.html"

# Generate HTML reports for all existing JSON files
reports-all: reports-dir
    @echo "Generating HTML reports for all JSON files..."
    @for f in reports/*.json; do \
        base=$$(basename "$$f" .json); \
        node generate-report.js "$$f" "reports/$$base.html"; \
    done
    @echo "All reports generated."

# View console summary for a report
view report:
    @node generate-report.js --console reports/{{ report }}.json

# Clean up all reports
clean:
    @echo "Cleaning reports..."
    @rm -rf reports/*.json reports/*.html
    @echo "Reports cleaned"

# ============================================================================
# Help
# ============================================================================

# Show detailed help
help:
    @echo "Artillery Load Testing — Qwen2.5-3B-AWQ + vLLM ± LMCache (Approach B)"
    @echo ""
    @echo "EXPERIMENT B (APC eviction — primary workflow):"
    @echo "  just qwen25-approachb-full            - Full A/B suite (deploy+test both variants, huge prefix)"
    @echo "  just qwen25-deploy-approachb-baseline - Deploy baseline (APC on, no LMCache, gpu-util=0.55)"
    @echo "  just qwen25-deploy-approachb-lmcache  - Deploy treatment (APC on + LMCache, gpu-util=0.55)"
    @echo "  just qwen25-huge-prefix               - Run huge-prefix eviction test (~9.7K tokens, 2:1 buster:prefix)"
    @echo "  just qwen25-eviction                  - Run eviction mix test (~5K tokens, 1:1 buster:prefix)"
    @echo "  just qwen25-gen-busters               - Regenerate eviction-busters.csv (~20 unique ~2K-token prompts)"
    @echo ""
    @echo "UTILITIES:"
    @echo "  just qwen25-metrics           - Scrape lmcache:* / vllm:* from /metrics"
    @echo "  just qwen25-api-key           - Print the VLLM_LOCAL_API_KEY from the k8s secret"
    @echo "  just qwen25-port-forward      - Port-forward :8090 to the qwen25 svc"
    @echo "  just qwen25-kill-port-forward - Kill the port-forward"
    @echo "  just qwen25-check             - Wait for the model pod to be Ready"
    @echo ""
    @echo "REPORT GENERATION:"
    @echo "  just report <name>  - Generate HTML for reports/<name>.json"
    @echo "  just reports-all    - Generate HTML for all JSON reports"
    @echo "  just view <name>    - Print console summary of a report"
    @echo "  just clean          - Remove all report files"
    @echo ""
    @echo "PREREQUISITES:"
    @echo "  just check-deps     - Verify artillery / kubectl / jq are installed"
    @echo "  export VLLM_LOCAL_API_KEY=\$$(just qwen25-api-key)"
